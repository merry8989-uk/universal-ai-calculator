<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this app on its own.

    The privacy policy says calculations stay on the device, and the archive
    lives in the app's own folder. Allowing Android to back that up would quietly
    contradict both, so cloud backup and device transfer are both switched off.
    The user still has the export button, which is a deliberate act rather than a
    silent one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
