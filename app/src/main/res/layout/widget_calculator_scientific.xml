<?xml version="1.0" encoding="utf-8"?>
<!-- The scientific widget: the usual digit grid on the left, a function strip
     on the right, so a quick sin or root is one tap from the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_solid"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="10dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:maxLines="1"
        android:ellipsize="start"
        android:text="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="7" />
        <Button
            android:id="@+id/w8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="8" />
        <Button
            android:id="@+id/w9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="9" />
        <Button
            android:id="@+id/w_div"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_op"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="÷" />
        <Button
            android:id="@+id/s_sin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="sin" />
        <Button
            android:id="@+id/s_cos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="cos" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="4" />
        <Button
            android:id="@+id/w5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="5" />
        <Button
            android:id="@+id/w6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="6" />
        <Button
            android:id="@+id/w_mul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_op"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="×" />
        <Button
            android:id="@+id/s_tan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="tan" />
        <Button
            android:id="@+id/s_ln"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="ln" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="1" />
        <Button
            android:id="@+id/w2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="2" />
        <Button
            android:id="@+id/w3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="3" />
        <Button
            android:id="@+id/w_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_op"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="−" />
        <Button
            android:id="@+id/s_sqrt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="√" />
        <Button
            android:id="@+id/s_x2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="x²" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="0" />
        <Button
            android:id="@+id/w_dot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="." />
        <Button
            android:id="@+id/w_eq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_eq"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="=" />
        <Button
            android:id="@+id/w_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_op"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="+" />
        <Button
            android:id="@+id/s_pi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="π" />
        <Button
            android:id="@+id/s_lp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="(" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_clear"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="C" />
        <Button
            android:id="@+id/w_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_clear"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="⌫" />
        <Button
            android:id="@+id/w_pct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_op"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="%" />
        <Button
            android:id="@+id/s_00"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="00" />
        <Button
            android:id="@+id/s_rp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text=")" />
        <Button
            android:id="@+id/s_xy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_key_digit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="xʸ" />
    </LinearLayout>

</LinearLayout>
