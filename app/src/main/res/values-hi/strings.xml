    <string name="sync_code">सिंक कोड</string>
    <string name="sync_code_help">कम से कम %1$d अक्षर। हर डिवाइस पर वही कोड डालें। हम इसे आपके लिए वापस नहीं ला सकते।</string>
    <string name="sync_code_saved">सिंक कोड इस डिवाइस पर सहेजा गया।</string>
