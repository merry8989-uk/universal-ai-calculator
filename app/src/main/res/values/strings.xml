    <!--
        Everything the Settings screen says.

        These were literal English in SettingsScreen.kt, which meant a phone set
        to Hindi showed a Hindi calculator and an English Settings screen — the
        one place a user goes to change the language was the one place that
        ignored it. A format argument is numbered so a translation may put it
        anywhere in the sentence.
    -->
    <string name="settings_section_data">Your data</string>
    <string name="settings_keep_calculations">Keep my calculations</string>
    <string name="settings_data_on">Answers are kept in a folder on this phone, the history keeps three days, and a log is kept for troubleshooting.</string>
    <string name="settings_data_off">Nothing is kept. No archive, no history, no log — on this phone or anywhere else.</string>
